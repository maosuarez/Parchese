{
  /* Config del proyecto TypeScript que describe el entorno donde corren las
   * funciones de Convex y sirve para typecheckearlas. Es el archivo estándar
   * que genera `convex dev`; faltaba en el repo.
   */
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"]
}
